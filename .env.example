# Copy to .env. Never commit .env.
# Generate each token with: python -c 'import secrets; print(secrets.token_urlsafe(24))'
# Format: token:role:name,...  with roles viewer | operator | senior_operator
# The API refuses to start with tokens under 16 characters, "change-me" placeholders, or duplicates.
NETPULSE_API_TOKENS=
# Token the Streamlit UI sends to the API (copy one of the tokens above)
NETPULSE_UI_TOKEN=
NETPULSE_LLM_PROVIDER=heuristic
