# Copy to .env (git-ignored) or export in your shell. Never commit real values.

# --- model provider ---------------------------------------------------------
# mock (default, offline, deterministic) | gemini
OPSPILOT_MODEL_PROVIDER=mock
OPSPILOT_MODEL=gemini-2.5-flash

# Gemini Developer API (AI Studio key):
# GOOGLE_API_KEY=your-key-here
# --- or Vertex AI with Application Default Credentials (gcloud auth application-default login):
# GOOGLE_GENAI_USE_VERTEXAI=1
# GOOGLE_CLOUD_PROJECT=your-project
# GOOGLE_CLOUD_LOCATION=us-central1

# --- storage ----------------------------------------------------------------
# OPSPILOT_DATA_DIR=var/datasets
# OPSPILOT_SESSION_DB=sqlite+aiosqlite:///var/sessions.db
# OPSPILOT_DEFAULT_DATASET=C02
# Bearer token for `opspilot serve` (>= 32 chars); required to bind beyond loopback.
# OPSPILOT_API_TOKEN=

# --- limits -----------------------------------------------------------------
# OPSPILOT_MAX_LLM_CALLS=40
# OPSPILOT_MAX_LLM_CALLS_PER_AGENT=8
# OPSPILOT_MAX_TOOL_CALLS=60
# OPSPILOT_MAX_DURATION_S=120
# OPSPILOT_MAX_MODEL_ATTEMPTS=2
# OPSPILOT_RETRY_INITIAL_DELAY_S=1
# OPSPILOT_RETRY_MAX_DELAY_S=8
# OPSPILOT_MODEL_TIMEOUT_S=60
# OPSPILOT_MAX_REQUEST_CHARS=4000
# 1 = single pass; 2 = one extra round that retries stages that failed
# OPSPILOT_MAX_INVESTIGATION_ROUNDS=1

# --- cost estimation --------------------------------------------------------
# JSON price table (see prices.example.json); unset = no cost estimate.
# OPSPILOT_PRICE_TABLE=prices.json

# --- tracing (docs/observability.md) ---------------------------------------
# Needs the exporter per run: uv run --with 'opentelemetry-exporter-otlp-proto-http==1.42.1' ...
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318        # OTLP/HTTP; traces + logs + metrics
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://localhost:4318/v1/traces   # traces only
# OTEL_SERVICE_NAME=opspilot
# OTEL_BSP_SCHEDULE_DELAY=500                              # flush sooner (SIGTERM can drop the last batch)
# ADK_CAPTURE_MESSAGE_CONTENT_IN_SPANS=false               # export timing/structure, not prompts or tool results

# --- semantic retrieval -----------------------------------------------------
# hashing (default, offline) | gemini (sends document/query text to the Gemini API;
# vectors are cached in SQLite so repeat runs work offline)
# OPSPILOT_EMBEDDER=hashing
# OPSPILOT_EMBEDDING_MODEL=gemini-embedding-001
# OPSPILOT_EMBEDDING_DIMS=768
# OPSPILOT_EMBEDDING_CACHE=var/embeddings.db
# OPSPILOT_EMBEDDING_MIN_COSINE=0.6

# --- logging ----------------------------------------------------------------
# OPSPILOT_LOG_LEVEL=WARNING
# OPSPILOT_LOG_JSON=1
