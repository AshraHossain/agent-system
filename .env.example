# Copy to .env. Never commit .env.
# token:role:name,... with roles viewer | operator | senior_operator
NETPULSE_API_TOKENS=change-me-operator:operator:olga,change-me-senior:senior_operator:sam,change-me-viewer:viewer:vic
# Token the Streamlit UI sends to the API (use one of the tokens above)
NETPULSE_UI_TOKEN=change-me-operator
NETPULSE_LLM_PROVIDER=heuristic
