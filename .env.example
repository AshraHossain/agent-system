# Copy to .env. Never commit .env.
# Generate each token with: python -c 'import secrets; print(secrets.token_urlsafe(24))'
# AUTH. Production: NETPULSE_AUTH_MODE=oidc (see docs/operations.md). Static tokens below are for development only.
NETPULSE_AUTH_MODE=tokens
# oidc mode (all three required; the issuer must be https):
# NETPULSE_OIDC_ISSUER=https://idp.example.com
# NETPULSE_OIDC_AUDIENCE=netpulse-api
# NETPULSE_OIDC_ROLE_MAP=netpulse-viewers=viewer,netpulse-operators=operator,netpulse-seniors=senior_operator
# tokens mode format: token:role:name,...  with roles viewer | operator | senior_operator
# The API refuses to start with tokens under 16 characters, "change-me" placeholders, or duplicates.
NETPULSE_API_TOKENS=
# Keys the audit log hash chain. 32+ characters. Keep it OUT of the database volume and back it up separately:
# losing it makes the existing log unverifiable. python -c 'import secrets; print(secrets.token_urlsafe(48))'
NETPULSE_AUDIT_KEY=
# tokens mode: the token the Streamlit UI sends. oidc mode: set NETPULSE_UI_TOKEN_HEADER (for example
# X-Forwarded-Access-Token) and put the UI behind an authenticating proxy such as oauth2-proxy.
NETPULSE_UI_TOKEN=
NETPULSE_UI_TOKEN_HEADER=
NETPULSE_LLM_PROVIDER=heuristic
